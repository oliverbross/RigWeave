#ifndef CP210xDriver_h
#define CP210xDriver_h

#include <DriverKit/IOService.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>

class CP210xDriver: public IOService
{
public:
	virtual kern_return_t Start(IOService* provider) override;
	virtual kern_return_t Stop(IOService* provider) override;
	virtual kern_return_t NewUserClient(uint32_t type, IOUserClient** userClient) override;

	bool userClientReady() LOCALONLY;
	kern_return_t userClientWrite(const void* bytes, uint32_t length) LOCALONLY;
	kern_return_t userClientRead(void* bytes, uint32_t capacity, uint32_t* transferred) LOCALONLY;

private:
	IOUSBHostInterface* usbInterface;
	IOUSBHostPipe* bulkIn;
	IOUSBHostPipe* bulkOut;
	bool interfaceOpen;

	kern_return_t configurePL2303() LOCALONLY;
	kern_return_t controlValue(uint8_t requestType, uint8_t request, uint16_t value, uint16_t index) LOCALONLY;
	kern_return_t controlBytes(uint8_t requestType, uint8_t request, uint16_t value, uint16_t index,
		const void* bytes, uint16_t length) LOCALONLY;
	kern_return_t writeBulk(const void* bytes, uint32_t length) LOCALONLY;
	kern_return_t readBulk(void* bytes, uint32_t capacity, uint32_t* transferred) LOCALONLY;
};

#endif
